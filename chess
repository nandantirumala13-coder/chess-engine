def square_rect(square):
    file = chess.square_file(square)
    rank = chess.square_rank(square)


    x = BOARD_X + file * SQUARE
    y = BOARD_Y + (7 - rank) * SQUARE


    return pygame.Rect(x, y, SQUARE, SQUARE)



   
